# ==========================================================
# Ideal City Finder — environment variables template
# ==========================================================
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in real values.
# 3. Add .env to .gitignore — this file contains secrets and
#    must never be committed to git.
# ==========================================================

# --- External API keys ---
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional, only if AEMET is used as the weather data source (see Prompt 7)
AEMET_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideal_city
REDIS_URL=redis://localhost:6379/0

# --- Rent price data source ---
# idealista_index = Idealista's public aggregated price index pages
# ine             = INE (Instituto Nacional de Estadística) official statistics
RENT_DATA_SOURCE=idealista_index

# --- Authentication (2 static users, see Prompt 2) ---
AUTH_USER_1_USERNAME=
AUTH_USER_1_PASSWORD=
AUTH_USER_2_USERNAME=
AUTH_USER_2_PASSWORD=

JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# --- Frontend ---
# Separate, domain-restricted browser key for Google Maps JS API
# (do not reuse the backend Places API key here)
VITE_GOOGLE_MAPS_JS_KEY=
VITE_API_BASE_URL=http://localhost:8000
